# Copy file นี้เป็น .env แล้วแก้ค่าให้ตรงกับ environment ของคุณ

# ── Supabase / PostgreSQL ───────────────────────────────────────
# หา connection string ได้ที่: Supabase Dashboard → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ── MySQL ──────────────────────────────────────────────────────
# DATABASE_URL=mysql+pymysql://attendance_user:yourpassword@localhost:3306/attendance_db

# ── SQLite (ค่าเริ่มต้น ไม่ต้องกำหนดถ้าใช้ SQLite) ────────────
# DATABASE_URL=sqlite:///attendance.db

# ── Secret key สำหรับ Flask session ───────────────────────────
SECRET_KEY=change-this-to-a-random-secret-key
