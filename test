<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>FIRN & JONG · Wedding</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Playfair+Display:ital,wght@0,400;0,500;0,700;1,400&family=Great+Vibes&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
<style>
:root{
  --cream:#F5E6D3;
  --cream-light:#FBF4EA;
  --blush:#D9B3B0;
  --blush-soft:#E9C9C6;
  --sage:#8FA181;
  --sage-deep:#6B7C5F;
  --brown:#7A5942;
  --gold:#B89968;
  --ink:#3B2E25;
  --paper:#FFFBF5;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  font-family:'Cormorant Garamond',serif;
  background:var(--paper);
  color:var(--ink);
  overflow-x:hidden;
  line-height:1.6;
}
.serif{font-family:'Playfair Display',serif}
.script{font-family:'Great Vibes',cursive}
.sans{font-family:'Inter',sans-serif;letter-spacing:.15em;text-transform:uppercase;font-size:.75rem}

/* ===== Floating music button ===== */
.music-btn{
  position:fixed;top:24px;right:24px;z-index:100;
  width:56px;height:56px;border-radius:50%;
  background:linear-gradient(135deg,var(--gold),var(--brown));
  border:2px solid var(--cream);
  box-shadow:0 8px 24px rgba(122,89,66,.35);
  cursor:pointer;display:flex;align-items:center;justify-content:center;
  transition:transform .3s,box-shadow .3s;
  color:var(--cream);
}
.music-btn:hover{transform:scale(1.1) rotate(8deg);box-shadow:0 12px 32px rgba(122,89,66,.5)}
.music-btn.playing{animation:pulse 2s infinite}
.music-btn svg{width:24px;height:24px}
@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(184,153,104,.7)}50%{box-shadow:0 0 0 16px rgba(184,153,104,0)}}
#yt-player{position:absolute;left:-9999px;top:-9999px;width:1px;height:1px}

/* ===== Floating petals ===== */
.petal{position:fixed;top:-20px;pointer-events:none;z-index:1;opacity:.6;animation:fall linear infinite}
@keyframes fall{
  0%{transform:translateY(-10vh) translateX(0) rotate(0)}
  100%{transform:translateY(110vh) translateX(40px) rotate(720deg)}
}

/* ===== Hero / Cover ===== */
.hero{
  min-height:100vh;display:grid;grid-template-columns:1fr 1.4fr;
  position:relative;overflow:hidden;
}
.hero-left{
  background:var(--blush);
  display:flex;align-items:center;justify-content:center;
  position:relative;
}
.hero-right{
  background:var(--sage);
  display:flex;flex-direction:column;justify-content:center;
  padding:8vw 6vw;color:var(--cream-light);
}
.monogram{
  font-family:'Playfair Display',serif;font-style:italic;
  font-size:clamp(120px,18vw,260px);color:var(--sage-deep);
  line-height:1;letter-spacing:-.05em;
  animation:fadeUp 1.4s ease-out;
}
.hero-right .invite-top{
  font-family:'Great Vibes',cursive;
  font-size:clamp(1.6rem,3vw,2.4rem);color:var(--cream-light);
  margin-bottom:.5rem;animation:fadeUp 1.4s .2s both;
}
.hero-right .names{
  font-family:'Playfair Display',serif;
  font-size:clamp(2.8rem,7vw,6.5rem);color:var(--brown);
  font-style:italic;font-weight:500;line-height:1;
  letter-spacing:-.02em;animation:fadeUp 1.4s .4s both;
}
.hero-right .invite-bottom{
  font-family:'Cormorant Garamond',serif;font-style:italic;
  margin-top:1.5rem;color:var(--cream-light);font-size:1.1rem;
  animation:fadeUp 1.4s .6s both;
}
@keyframes fadeUp{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}

.scroll-hint{
  position:absolute;bottom:24px;left:50%;transform:translateX(-50%);
  color:var(--cream);font-size:.7rem;letter-spacing:.3em;
  animation:bob 2s ease-in-out infinite;z-index:5;
}
@keyframes bob{0%,100%{transform:translateX(-50%) translateY(0)}50%{transform:translateX(-50%) translateY(10px)}}

/* ===== Sections ===== */
section{padding:clamp(60px,10vh,120px) clamp(20px,6vw,80px);position:relative}
.section-title{
  text-align:center;font-family:'Playfair Display',serif;
  font-style:italic;font-size:clamp(2rem,5vw,3.5rem);
  color:var(--brown);margin-bottom:.5rem;
}
.section-subtitle{
  text-align:center;font-family:'Inter',sans-serif;
  letter-spacing:.3em;text-transform:uppercase;font-size:.75rem;
  color:var(--sage-deep);margin-bottom:3rem;
}
.divider{
  width:60px;height:1px;background:var(--gold);
  margin:1rem auto 2rem;position:relative;
}
.divider::before,.divider::after{
  content:'';position:absolute;top:-2px;width:5px;height:5px;
  border-radius:50%;background:var(--gold);
}
.divider::before{left:-12px}.divider::after{right:-12px}

/* Reveal on scroll */
.reveal{opacity:0;transform:translateY(40px);transition:opacity .9s ease,transform .9s ease}
.reveal.in{opacity:1;transform:translateY(0)}

/* ===== Story / Music section ===== */
.story{background:var(--cream)}
.story-card{
  max-width:880px;margin:0 auto;background:var(--paper);
  border:1px solid rgba(184,153,104,.3);
  padding:48px;text-align:center;
  box-shadow:0 30px 80px -40px rgba(122,89,66,.3);
  position:relative;
}
.story-card::before,.story-card::after{
  content:'';position:absolute;width:40px;height:40px;
  border:1px solid var(--gold);
}
.story-card::before{top:14px;left:14px;border-right:none;border-bottom:none}
.story-card::after{bottom:14px;right:14px;border-left:none;border-top:none}
.story-card p{font-size:1.15rem;font-style:italic;color:var(--brown);max-width:600px;margin:0 auto 24px}
.music-cta{
  display:inline-flex;align-items:center;gap:12px;
  background:linear-gradient(135deg,var(--gold),var(--brown));
  color:var(--cream);padding:14px 32px;border-radius:999px;
  border:none;cursor:pointer;font-family:'Inter',sans-serif;
  letter-spacing:.2em;text-transform:uppercase;font-size:.75rem;
  transition:transform .3s,box-shadow .3s;
  box-shadow:0 10px 30px -10px rgba(122,89,66,.5);
}
.music-cta:hover{transform:translateY(-2px);box-shadow:0 16px 40px -10px rgba(122,89,66,.6)}
.music-cta svg{width:14px;height:14px}

/* ===== Countdown ===== */
.countdown-wrap{background:var(--blush-soft);text-align:center;position:relative;overflow:hidden}
.countdown-wrap::before{
  content:'';position:absolute;inset:0;
  background:radial-gradient(circle at 20% 30%,rgba(255,255,255,.4),transparent 40%),
             radial-gradient(circle at 80% 70%,rgba(143,161,129,.2),transparent 40%);
  pointer-events:none;
}
.countdown-title{font-family:'Great Vibes',cursive;font-size:3rem;color:var(--brown);margin-bottom:8px}
.countdown-date{letter-spacing:.4em;font-size:.8rem;color:var(--sage-deep);margin-bottom:32px;text-transform:uppercase}
.countdown{
  display:grid;grid-template-columns:repeat(4,1fr);gap:20px;
  max-width:720px;margin:0 auto;
}
.cd-box{
  background:var(--paper);padding:24px 12px;border:1px solid rgba(184,153,104,.3);
  position:relative;
}
.cd-num{font-family:'Playfair Display',serif;font-size:clamp(2rem,5vw,3.5rem);color:var(--brown);line-height:1}
.cd-label{letter-spacing:.3em;font-size:.65rem;color:var(--sage-deep);margin-top:8px;text-transform:uppercase}

/* ===== About / Dress code ===== */
.about{background:var(--paper)}
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:48px;max-width:1100px;margin:0 auto;align-items:center}
.about-text p{font-size:1.1rem;color:var(--ink);margin-bottom:16px;line-height:1.8}
.dress-codes{display:flex;justify-content:center;gap:20px;margin-top:24px;flex-wrap:wrap}
.swatch{display:flex;flex-direction:column;align-items:center;gap:8px}
.swatch-circle{
  width:64px;height:64px;border-radius:50%;
  border:2px solid var(--paper);
  box-shadow:0 0 0 1px var(--gold),0 10px 24px -8px rgba(0,0,0,.15);
  transition:transform .4s;
}
.swatch:hover .swatch-circle{transform:scale(1.1) rotate(10deg)}
.swatch-label{font-family:'Inter',sans-serif;font-size:.7rem;letter-spacing:.2em;text-transform:uppercase;color:var(--brown)}

/* ===== Program ===== */
.program{background:linear-gradient(180deg,var(--cream-light),var(--cream))}
.timeline{max-width:720px;margin:0 auto;position:relative}
.timeline::before{
  content:'';position:absolute;left:50%;top:0;bottom:0;width:1px;
  background:linear-gradient(180deg,transparent,var(--gold) 20%,var(--gold) 80%,transparent);
}
.event{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:24px;margin-bottom:40px;position:relative}
.event-time{font-family:'Playfair Display',serif;font-style:italic;font-size:1.6rem;color:var(--brown)}
.event-dot{
  width:18px;height:18px;border-radius:50%;background:var(--paper);
  border:2px solid var(--gold);box-shadow:0 0 0 4px var(--cream);
  z-index:2;
}
.event-name{font-family:'Cormorant Garamond',serif;font-size:1.3rem;color:var(--sage-deep);font-style:italic}
.event:nth-child(even) .event-time{order:3;text-align:right}
.event:nth-child(even) .event-name{text-align:left}
.event:nth-child(odd) .event-time{text-align:right}
.event:nth-child(odd) .event-name{text-align:left}

/* ===== FAQ accordion ===== */
.faq{background:var(--blush-soft)}
.faq-list{max-width:780px;margin:0 auto}
.faq-item{
  background:var(--paper);margin-bottom:16px;border:1px solid rgba(184,153,104,.2);
  overflow:hidden;transition:box-shadow .3s;
}
.faq-item:hover{box-shadow:0 10px 30px -15px rgba(122,89,66,.3)}
.faq-q{
  display:flex;justify-content:space-between;align-items:center;
  padding:20px 24px;cursor:pointer;
  font-family:'Playfair Display',serif;font-style:italic;
  color:var(--brown);font-size:1.05rem;
}
.faq-q .num{font-family:'Inter',sans-serif;letter-spacing:.2em;color:var(--gold);font-size:.75rem;margin-right:16px}
.faq-toggle{font-size:1.5rem;color:var(--gold);transition:transform .3s}
.faq-item.open .faq-toggle{transform:rotate(45deg)}
.faq-a{max-height:0;overflow:hidden;transition:max-height .5s ease;padding:0 24px}
.faq-item.open .faq-a{max-height:300px;padding-bottom:20px}
.faq-a p{font-size:1rem;color:var(--ink);line-height:1.7}

